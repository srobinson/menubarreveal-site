# Dev files: everything else in this folder is the site. tools/deploy.mjs leaves these out of what it uploads, and
# tools/serve.mjs does not serve them. One path per line, from the root: a file, or a folder and everything in it.
# No patterns: the tools stop at a line they would have to guess at.
.git
.github
.gitignore
.assetsignore
.browserslistrc
.htmlvalidate.json
.stylelintrc.json
.deploy
.preview
.wrangler
LICENSE
NOTICE
README.md
facts.json
node_modules
package.json
package-lock.json
tools
wrangler.toml
www-redirect
